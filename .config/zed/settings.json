// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "show_edit_predictions": true,
  "diff_view_style": "unified",
  "which_key": {
    "enabled": false
  },
  "cli_default_open_behavior": "new_window",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
  },
  "colorize_brackets": true,
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "show_wrap_guides": true,
  "preferred_line_length": 80,
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "excerpt_context_lines": 5,
  "prettier": {
    "allowed": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
    "sort_by_path": true,
  },
  "disable_ai": false,
  "search": {
    "include_ignored": false,
  },
  "tabs": {
    "git_status": true,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
    "gutter_debounce": 5,
  },
  "ui_font_weight": 400.0,
  "ui_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "buffer_font_size": 15.0,
  "buffer_line_height": {
    "custom": 1.444,
  },
  "languages": {
    "Shell Script": {
      "prettier": {
        "allowed": true,
      },
      "colorize_brackets": true,
    },
    "TypeScript": {
      "language_servers": ["...", "eslint"],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "inlay_hints": {
        "show_background": false,
        "show_type_hints": true,
        "enabled": false,
      },
    },
    "Prisma": {
      "inlay_hints": {
        "enabled": true,
      },
    },
  },
  "file_finder": {
    "include_ignored": "smart",
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "hide_gitignore": false,
  },
  "soft_wrap": "editor_width",
  "wrap_guides": [80, 120],
  "inline_code_actions": true,
  "gutter": {
    "min_line_number_digits": 3,
    "line_numbers": true,
  },
  "ui_font_family": "Inter",
  "buffer_font_family": "IosevkaTerm Nerd Font Mono",
  "agent": {
    "notify_when_agent_waiting": "never",
    "thinking_display": "always_expanded",
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "dock": "right",
    "message_editor_min_lines": 6,
    "play_sound_when_agent_done": "never",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "model_parameters": [],
  },
  "preview_tabs": {
    "enabled": true
  },
  "terminal": {
    "font_size": 15.0,
    "default_height": 400.0,
    "env": {
      "EDITOR": "zed --wait",
    },
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "relative_line_numbers": "enabled",
  "tab_size": 2,
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Solarized Light",
    "dark": "Solarized Dark",
  },
  "theme_overrides": {
    "Solarized Light": {
      "accents": [
        "#6c71c4",
        "#859900",
        "#dc322f",
        "#268bd2",
        "#b58900",
        "#d33682",
        "#2aa198",
        "#cb4b16",
      ],
    },
    "Solarized Dark": {
      "one level": {
        "another": ["yes", ["finally", []]],
      },
    },
  },
}
